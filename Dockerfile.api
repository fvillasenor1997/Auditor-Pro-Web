# Dockerfile.api
FROM node:20-alpine

# Instalar pnpm
RUN npm install -g pnpm

# Establecer directorio de trabajo
WORKDIR /app

# Copiar todo el código fuente
COPY . .

# Instalar todas las dependencias del monorepo
RUN pnpm install

# Construir las librerías compartidas y la API
# Esto asegura que lib/db y lib/api-zod se compilen si es necesario
RUN pnpm run build --filter ./artifacts/api-server...

# Exponer el puerto de la API
EXPOSE 3000

# Iniciar la API
WORKDIR /app/artifacts/api-server
CMD ["pnpm", "start"]