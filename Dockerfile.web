# Dockerfile.web
# Etapa 1: Construcción
FROM node:20-alpine AS builder
RUN npm install -g pnpm
WORKDIR /app
COPY . .
RUN pnpm install
RUN pnpm run build --filter ./artifacts/auditor-pro...

# Etapa 2: Servidor de Producción (Nginx)
FROM nginx:alpine
# Copiamos la app construida
COPY --from=builder /app/artifacts/auditor-pro/dist /usr/share/nginx/html
# Copiamos la configuración especial para aplicaciones React
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]