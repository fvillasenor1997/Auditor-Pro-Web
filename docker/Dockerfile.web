# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY lib/db ./lib/db
COPY scripts ./scripts
COPY artifacts/auditor-pro ./artifacts/auditor-pro

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/auditor-pro run build

# ── Stage 2: Nginx ───────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=builder /app/artifacts/auditor-pro/dist/public /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
