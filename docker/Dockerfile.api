# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY lib/db ./lib/db
COPY lib/integrations ./lib/integrations
COPY scripts ./scripts
COPY artifacts/api-server ./artifacts/api-server
COPY artifacts/api-zod ./artifacts/api-zod

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: Production ──────────────────────────────────────────────────────
FROM node:22-alpine
WORKDIR /app

RUN corepack enable

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY lib/db ./lib/db
COPY lib/integrations ./lib/integrations
COPY scripts ./scripts

# Install only production dependencies for @workspace/db (needed by api-server)
RUN pnpm install --frozen-lockfile --filter @workspace/db --prod

COPY --from=builder /app/artifacts/api-server/dist ./dist

COPY docker/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
